---
import SectionHeading from './SectionHeading.astro';
import { skillGroups, practices } from '../data/skills';
import { platforms } from '../data/site';
---

<section id="skills" class="py-24 sm:py-32">
  <div class="container-x">
    <SectionHeading
      index="05"
      label="Skills"
      title="The toolbox."
      lead="Only what I’ve shipped with. Highlighted items are years-deep; the rest I’ve used in real work and can talk about in detail."
    />

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((g, i) => (
          <div class="card reveal p-6" style={`--delay: ${(i % 3) * 60}ms`}>
            <h3 class="font-semibold tracking-tight">{g.title}</h3>
            <p class="mt-1 text-sm text-subtle">{g.blurb}</p>
            <ul class="mt-5 flex flex-wrap gap-1.5">
              {g.core.map((s) => (
                <li class="chip border-accent/30 bg-accent-soft text-ink">
                  <span class="size-1.5 rounded-full bg-accent" />
                  {s}
                </li>
              ))}
              {g.working.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="reveal mt-10 grid gap-8 border-t border-line pt-10 md:grid-cols-2">
      <div>
        <h3 class="eyebrow">Third-party APIs integrated in production</h3>
        <p class="mt-3 text-lg leading-relaxed text-muted">
          {platforms.map((p, i) => <><span class="whitespace-nowrap">{p}{i < platforms.length - 1 && <span class="text-subtle"> ·</span>}</span>{' '}</>)}
        </p>
      </div>
      <div>
        <h3 class="eyebrow">How I work</h3>
        <p class="mt-3 text-lg leading-relaxed text-muted">
          {practices.map((p, i) => <><span class="whitespace-nowrap">{p}{i < practices.length - 1 && <span class="text-subtle"> ·</span>}</span>{' '}</>)}
        </p>
      </div>
    </div>
  </div>
</section>
