---
// Shared renderer for the small architecture diagrams on case-study pages.
// Coordinates are in viewBox units; the SVG scales to the column width.
export type Node = {
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub?: string;
  sub2?: string;
  kind?: 'default' | 'accent' | 'fail' | 'group';
  align?: 'middle' | 'start';
};
export type Edge = { d: string; dashed?: boolean; accent?: boolean; both?: boolean };
export type Label = { x: number; y: number; text: string; anchor?: 'start' | 'middle' | 'end' };

interface Props {
  id: string;
  width: number;
  height: number;
  nodes: Node[];
  edges: Edge[];
  labels?: Label[];
  title: string;
  caption: string;
}

const { id, width, height, nodes, edges, labels = [], title, caption } = Astro.props;
const cls = { default: 'box', accent: 'box box-accent', fail: 'box box-fail', group: 'group' } as const;
---

<figure class="mb-12">
  <div class="card overflow-x-auto p-4 sm:p-6">
    <svg
      class="dg"
      viewBox={`0 0 ${width} ${height}`}
      role="img"
      aria-labelledby={`${id}-title ${id}-desc`}
      style={`min-width: ${Math.round(width * 0.82)}px`}
    >
      <title id={`${id}-title`}>{title}</title>
      <desc id={`${id}-desc`}>{caption}</desc>
      <defs>
        <marker id={`${id}-h`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="head"></path>
        </marker>
        <marker id={`${id}-ha`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,0 L10,5 L0,10 z" class="head-accent"></path>
        </marker>
      </defs>

      {
        edges.map((e) => (
          <path
            d={e.d}
            class:list={['edge', e.dashed && 'edge-dash', e.accent && 'edge-accent']}
            marker-end={`url(#${id}-${e.accent ? 'ha' : 'h'})`}
            marker-start={e.both ? `url(#${id}-${e.accent ? 'ha' : 'h'})` : undefined}
          />
        ))
      }

      {
        nodes.map((n) => {
          const kind = n.kind ?? 'default';
          const tx = n.align === 'start' ? n.x + 14 : n.x + n.w / 2;
          const anchor = n.align === 'start' ? 'start' : 'middle';
          const lines = [n.sub, n.sub2].filter(Boolean) as string[];
          const titleY = kind === 'group' ? n.y + 20 : n.y + n.h / 2 - (lines.length * 7) + 4;
          return (
            <g>
              <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="10" class={cls[kind]} />
              <text x={tx} y={titleY} text-anchor={anchor} class:list={['t', kind === 'group' && 'tg']}>
                {n.title}
              </text>
              {lines.map((line, i) => (
                <text x={tx} y={titleY + 16 + i * 14} text-anchor={anchor} class="s">
                  {line}
                </text>
              ))}
            </g>
          );
        })
      }

      {
        labels.map((l) => (
          <text x={l.x} y={l.y} text-anchor={l.anchor ?? 'middle'} class="l">
            {l.text}
          </text>
        ))
      }
    </svg>
  </div>
  <figcaption class="mt-3 text-sm leading-relaxed text-subtle">{caption}</figcaption>
</figure>
