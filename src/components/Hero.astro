---
import Icon from './Icon.astro';
import { site, socials, platforms, stats } from '../data/site';

const commits = stats.find((s) => s.label === 'commits shipped')?.value ?? '';
---

<section class="relative overflow-hidden">
  <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="glow-orb -top-40 left-1/2 h-[28rem] w-[44rem] -translate-x-1/2 opacity-80" aria-hidden="true"></div>

  <div class="container-x relative grid items-center gap-14 pt-16 pb-20 sm:pt-24 lg:grid-cols-[1.15fr_0.85fr] lg:gap-16 lg:pt-28 lg:pb-28">
    <div>
      <p class="reveal inline-flex items-center gap-2.5 rounded-full border border-line bg-surface/70 py-1.5 pr-3.5 pl-2.5 text-sm text-muted backdrop-blur">
        <span class="pulse-dot size-2 rounded-full bg-accent"></span>
        {site.role} · {site.company}
      </p>

      <h1
        class="reveal mt-6 text-[2.6rem] leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-[4.25rem]"
        style="--delay: 60ms"
      >
        I build <span class="whitespace-nowrap">ad-tech</span> that <span class="text-gradient">stays correct</span> at scale.
      </h1>

      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-pretty text-muted" style="--delay: 120ms">
        Hi, I’m {site.shortName}. For 4+ years I’ve built Optmyzr’s PPC optimization platform end to end — React/Redux
        front ends, C#/.NET pipelines and PHP services — against the Google, Microsoft, Meta, LinkedIn and Amazon Ads
        APIs. I like the hard parts: rate limits, partial failures, and the rules platforms don’t document.
      </p>

      <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--delay: 180ms">
        <a href="#work" class="btn btn-primary">
          See my work
          <Icon name="arrow" size={16} />
        </a>
        <a href="#contact" class="btn btn-ghost">Get in touch</a>
      </div>

      <ul class="reveal mt-8 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-subtle" style="--delay: 240ms">
        <li class="flex items-center gap-1.5"><Icon name="pin" size={15} /> {site.location}</li>
        {
          socials
            .filter((s) => s.icon !== 'mail')
            .map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener"
                  class="flex items-center gap-1.5 transition-colors hover:text-ink"
                >
                  <Icon name={s.icon} size={15} />
                  {s.label}
                </a>
              </li>
            ))
        }
      </ul>
    </div>

    <!-- Terminal card -->
    <div class="reveal" style="--delay: 200ms">
      <div class="card overflow-hidden font-mono text-[13px] leading-relaxed sm:text-sm">
        <div class="flex items-center gap-2 border-b border-line px-4 py-3">
          <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
          <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
          <span class="size-2.5 rounded-full bg-[#28c840]"></span>
          <span class="ml-3 text-xs text-subtle">~/vishal — zsh</span>
        </div>
        <div class="space-y-4 p-5 sm:p-6">
          <div>
            <p><span class="text-accent">❯</span> <span class="text-ink">whoami</span></p>
            <p class="text-muted">vishal tiwari — full-stack engineer, gurgaon</p>
          </div>
          <div>
            <p><span class="text-accent">❯</span> <span class="text-ink">stack --core</span></p>
            <p class="text-muted">react · redux · c#/.net · php · mysql · mongodb · redis · aws</p>
          </div>
          <div>
            <p><span class="text-accent">❯</span> <span class="text-ink">platforms --in-production</span></p>
            <p class="text-muted">{platforms.map((p) => p.split(' (')[0].toLowerCase()).join(' · ')}</p>
          </div>
          <div>
            <p><span class="text-accent">❯</span> <span class="text-ink">git log --author=vishal --no-merges | wc -l</span></p>
            <p class="text-muted">{commits.replace('+', '')}<span class="text-accent">+</span></p>
          </div>
          <p>
            <span class="text-accent">❯</span>
            <span class="cursor-blink inline-block h-4 w-2 translate-y-0.5 bg-accent"></span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
