---
interface Props {
  index: string;
  label: string;
  title: string;
  lead?: string;
}
const { index, label, title, lead } = Astro.props;
---

<div class="reveal mb-10 max-w-2xl sm:mb-14">
  <p class="eyebrow flex items-center gap-3">
    <span class="text-accent">{index}</span>
    <span class="h-px w-8 bg-line-strong"></span>
    {label}
  </p>
  <h2 class="mt-4 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
  {lead && <p class="mt-4 text-lg leading-relaxed text-pretty text-muted">{lead}</p>}
  <slot />
</div>
