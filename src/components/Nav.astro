---
import Icon from './Icon.astro';
import { nav, site } from '../data/site';
---

<header
  data-header
  class="sticky top-0 z-50 border-b border-transparent transition-colors duration-300 data-[scrolled]:border-line data-[scrolled]:bg-bg/75 data-[scrolled]:backdrop-blur-xl"
>
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2.5" aria-label={`${site.name} — home`}>
      <span
        class="grid size-8 place-items-center rounded-lg border border-line-strong bg-surface font-mono text-[13px] font-semibold tracking-tight transition-colors group-hover:border-accent"
      >
        <span>V<span class="text-accent">T</span></span>
      </span>
      <span class="hidden font-medium tracking-tight sm:inline">{site.name}</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm text-muted">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="rounded-full px-3 py-2 transition-colors hover:bg-surface-2 hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      {
        site.resumeUrl && (
          <a href={site.resumeUrl} class="btn btn-ghost hidden h-9 px-4 text-sm sm:inline-flex">
            Résumé
          </a>
        )
      }
      <button
        type="button"
        data-theme-toggle
        aria-label="Toggle theme"
        class="grid size-9 place-items-center rounded-full border border-line text-muted transition-colors hover:border-line-strong hover:text-ink"
      >
        <Icon name="sun" class="hidden dark:block" />
        <Icon name="moon" class="block dark:hidden" />
      </button>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
        class="grid size-9 place-items-center rounded-full border border-line text-muted md:hidden"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" data-menu hidden class="border-t border-line bg-bg/95 backdrop-blur-xl md:hidden">
    <ul class="container-x flex flex-col py-3">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="flex items-center justify-between py-3 text-lg text-ink">
              {item.label}
              <Icon name="arrow" class="text-subtle" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>
