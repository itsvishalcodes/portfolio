---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { principles } from '../data/principles';
---

<section id="approach" class="border-t border-line bg-surface/30 py-24 sm:py-32">
  <div class="container-x">
    <SectionHeading
      index="02"
      label="Approach"
      title="How I work."
      lead="The habits behind the work above — each one linked to where it shows."
    />

    <ol class="grid gap-px overflow-hidden rounded-[1.25rem] border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {
        principles.map((p, i) => (
          <li class="reveal flex flex-col bg-surface p-6 sm:p-7" style={`--delay: ${(i % 3) * 60}ms`}>
            <span class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 text-lg font-semibold tracking-tight">{p.title}</h3>
            <p class="mt-2 leading-relaxed text-pretty text-muted">{p.body}</p>
            <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1.5 pt-5 text-sm">
              {p.proof.map((link) => (
                <li>
                  <a href={`/work/${link.slug}/`} class="group inline-flex items-center gap-1 text-ink hover:text-accent">
                    {link.label}
                    <Icon name="arrow" size={13} class="text-subtle transition-transform group-hover:translate-x-0.5 group-hover:text-accent" />
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
