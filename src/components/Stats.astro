---
import { stats } from '../data/site';
---

<section aria-label="By the numbers" class="border-y border-line bg-surface/40">
  <div class="container-x">
    <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
      {
        stats.map((s, i) => (
          <div
            class:list={[
              'reveal flex flex-col gap-1 py-7 pr-4',
              i % 2 === 1 && 'pl-4 sm:pl-0',
              'border-line max-sm:[&:nth-child(n+3)]:border-t sm:max-lg:[&:nth-child(n+4)]:border-t',
              'lg:pl-5 lg:first:pl-0 lg:[&:not(:first-child)]:border-l',
            ]}
            style={`--delay: ${i * 50}ms`}
          >
            <dt class="order-2 text-sm text-muted">{s.label}</dt>
            <dd class="order-1 text-3xl font-semibold tracking-tight tabular-nums">{s.value}</dd>
            <dd class="order-3 text-xs text-subtle">{s.note}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
