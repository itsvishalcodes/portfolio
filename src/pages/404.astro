---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Not found" description="This page doesn't exist.">
  <section class="relative overflow-hidden">
    <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-x relative flex min-h-[70vh] flex-col items-center justify-center py-24 text-center">
      <p class="font-mono text-sm text-accent">404</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">This page returned 200 OK in spirit only.</h1>
      <p class="mt-4 max-w-md text-lg text-muted">The link you followed doesn’t match anything here.</p>
      <a href="/" class="btn btn-primary mt-8">
        <Icon name="back" size={16} /> Back home
      </a>
    </div>
  </section>
</Base>
